# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost/crystalshards_development
DOCS_DATABASE_URL=postgres://postgres:password@localhost/crystaldocs_development
GIGS_DATABASE_URL=postgres://postgres:password@localhost/crystalgigs_development

# Documentation build queue (production only).
# Local development needs none of these: the queue is in-process and no
# Google Cloud credentials are required to run the apps or the specs.
# GOOGLE_CLOUD_PROJECT=crystalshards-org
# DOCS_BUILD_QUEUE=docs-builds
# DOCS_BUILD_QUEUE_LOCATION=us-central1
# DOCS_LAUNCHER_URL=https://docs-launcher-xxxxx.us-central1.run.app
# DOCS_TASKS_SERVICE_ACCOUNT=docs-tasks@crystalshards-org.iam.gserviceaccount.com

# GitHub Integration
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Stripe Configuration (for CrystalGigs)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# MinIO Configuration (for documentation storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=crystaldocs

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@crystalshards.org

# Application Settings
SECRET_KEY_BASE=your_secret_key_base_here
DOMAIN=localhost
SHARDS_REGISTRY_PORT=3000
DOCS_PORT=3001
GIGS_PORT=3002

# Job ads (CrystalGigs promotable feed)
# Read by CrystalShards, CrystalDocs and CrystalBits to render the job ad
# strip and the newsletter job block. There is no default: production refuses
# to start without it, and leaving it unset elsewhere turns the ad off.
JOB_ADS_URL=http://localhost:3002/api/ads

# Development/Production
CRYSTAL_ENV=development
LOG_LEVEL=DEBUG

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Search Configuration
SEARCH_INDEX_TYPE=database  # options: database, elasticsearch

# Documentation Build Settings
DOC_BUILD_TIMEOUT=300
DOC_MAX_FILE_SIZE=10485760  # 10MB
DOC_ALLOWED_EXTENSIONS=.cr,.md,.yml,.yaml,.json