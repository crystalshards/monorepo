#!/usr/bin/env crystal

require "json"
require "colorize"

# Renders Claude streaming JSON output in a human-readable format
class ClaudeStreamRenderer
  def initialize(@io : IO = STDIN, @output : IO = STDOUT)
    @current_text = ""
    @in_tool_use = false
    @tool_name = ""
    @tool_input_buffer = String::Builder.new
    @indentation = 0
  end

  def run
    buffer = String::Builder.new
    brace_count = 0
    in_string = false
    escape_next = false

    @io.each_line do |line|
      # Track opening and closing braces to find complete JSON objects
      # Must handle strings properly since they can contain braces
      line.each_char do |char|
        buffer << char

        if escape_next
          escape_next = false
          next
        end

        case char
        when '\\'
          if in_string
            escape_next = true
          end
        when '"'
          in_string = !in_string
        when '{', '}'
          if !in_string
            brace_count += 1 if char == '{'
            brace_count -= 1 if char == '}'

            # Complete JSON object found
            if brace_count == 0
              begin
                data = JSON.parse(buffer.to_s)
                process_event(data)
              rescue ex : JSON::ParseException
                @output.puts "⚠️  Parse error: #{ex.message}".colorize(:yellow)
              end
              buffer = String::Builder.new
            end
          end
        end
      end
    end
  end

  private def indent : String
    "  " * @indentation
  end

  private def format_tool_input(tool_name : String, input : String) : String
    begin
      data = JSON.parse(input)

      case tool_name
      when "Bash"
        format_bash_tool(data)
      when "Read"
        format_read_tool(data)
      when "Edit"
        format_edit_tool(data)
      when "Write"
        format_write_tool(data)
      when "Glob", "Grep"
        format_search_tool(tool_name, data)
      when "TodoWrite"
        format_todo_tool(data)
      when "SlashCommand"
        format_slash_command(data)
      else
        format_generic_tool(data)
      end
    rescue
      # If parsing fails, return the raw input
      input.size > 2000 ? "#{input[0..2000]}... (#{input.size} chars)" : input
    end
  end

  private def format_bash_tool(data : JSON::Any) : String
    command = data["command"]?.try(&.as_s) || ""
    desc = data["description"]?.try(&.as_s)

    result = String::Builder.new
    result << "\n#{indent}  📝 ".colorize(:cyan).to_s
    result << command.colorize(:white).to_s
    if desc
      result << "\n#{indent}  💡 ".colorize(:dark_gray).to_s
      result << desc.colorize(:dark_gray).to_s
    end
    result.to_s
  end

  private def format_read_tool(data : JSON::Any) : String
    file = data["file_path"]?.try(&.as_s) || ""
    offset = data["offset"]?.try(&.as_i)
    limit = data["limit"]?.try(&.as_i)

    result = String::Builder.new
    result << "\n#{indent}  📄 ".colorize(:cyan).to_s
    result << file.colorize(:white).to_s
    if offset || limit
      result << "\n#{indent}  📊 ".colorize(:dark_gray).to_s
      result << "lines #{offset || 0}-#{(offset || 0) + (limit || 0)}".colorize(:dark_gray).to_s
    end
    result.to_s
  end

  private def format_edit_tool(data : JSON::Any) : String
    file = data["file_path"]?.try(&.as_s) || ""
    old = data["old_string"]?.try(&.as_s) || ""
    new_str = data["new_string"]?.try(&.as_s) || ""
    replace_all = data["replace_all"]?.try(&.as_bool) || false

    result = String::Builder.new
    result << "\n#{indent}  ✏️  ".colorize(:cyan).to_s
    result << file.colorize(:white).to_s
    result << "\n#{indent}  🔄 ".colorize(:dark_gray).to_s
    result << (replace_all ? "Replace All" : "Replace First").colorize(:yellow).to_s

    # Show truncated old/new strings
    if old.size > 1000
      result << "\n#{indent}  ➖ ".colorize(:red).to_s
      result << "\"#{old[0..1000]}...\" (#{old.size} chars)".colorize(:red).to_s
    else
      result << "\n#{indent}  ➖ ".colorize(:red).to_s
      result << "\"#{old}\"".colorize(:red).to_s
    end

    if new_str.size > 1000
      result << "\n#{indent}  ➕ ".colorize(:green).to_s
      result << "\"#{new_str[0..1000]}...\" (#{new_str.size} chars)".colorize(:green).to_s
    else
      result << "\n#{indent}  ➕ ".colorize(:green).to_s
      result << "\"#{new_str}\"".colorize(:green).to_s
    end

    result.to_s
  end

  private def format_write_tool(data : JSON::Any) : String
    file = data["file_path"]?.try(&.as_s) || ""
    content = data["content"]?.try(&.as_s) || ""

    result = String::Builder.new
    result << "\n#{indent}  💾 ".colorize(:cyan).to_s
    result << file.colorize(:white).to_s
    result << "\n#{indent}  📏 ".colorize(:dark_gray).to_s
    result << "#{content.size} chars (#{content.lines.size} lines)".colorize(:dark_gray).to_s
    result.to_s
  end

  private def format_search_tool(name : String, data : JSON::Any) : String
    pattern = data["pattern"]?.try(&.as_s) || ""
    path = data["path"]?.try(&.as_s)
    glob = data["glob"]?.try(&.as_s)

    result = String::Builder.new
    result << "\n#{indent}  🔍 ".colorize(:cyan).to_s
    result << pattern.colorize(:white).to_s
    if path
      result << "\n#{indent}  📂 ".colorize(:dark_gray).to_s
      result << path.colorize(:dark_gray).to_s
    end
    if glob
      result << "\n#{indent}  🎯 ".colorize(:dark_gray).to_s
      result << glob.colorize(:dark_gray).to_s
    end
    result.to_s
  end

  private def format_todo_tool(data : JSON::Any) : String
    todos = data["todos"]?.try(&.as_a)
    return "" unless todos

    result = String::Builder.new
    result << "\n#{indent}  📋 Tasks:"
    todos.each do |todo|
      status = todo["status"]?.try(&.as_s) || "pending"
      content = todo["content"]?.try(&.as_s) || ""

      symbol = case status
      when "completed" then "✅"
      when "in_progress" then "🔧"
      else "⏳"
      end

      color = case status
      when "completed" then :green
      when "in_progress" then :yellow
      else :dark_gray
      end

      result << "\n#{indent}    #{symbol} ".colorize(color).to_s
      result << content.colorize(color).to_s
    end
    result.to_s
  end

  private def format_slash_command(data : JSON::Any) : String
    command = data["command"]?.try(&.as_s) || ""

    result = String::Builder.new
    result << "\n#{indent}  ⚡ ".colorize(:cyan).to_s
    result << command.colorize(:white).to_s
    result.to_s
  end

  private def format_generic_tool(data : JSON::Any) : String
    # For unknown tools, show key fields
    result = String::Builder.new
    count = 0
    data.as_h.each do |key, value|
      next if count >= 3  # Limit to first 3 fields

      result << "\n#{indent}  🔹 #{key}: ".colorize(:cyan).to_s

      if value.as_s?
        str = value.as_s
        if str.size > 300
          result << "#{str[0..300]}... (#{str.size} chars)".colorize(:dark_gray).to_s
        else
          result << str.colorize(:white).to_s
        end
      elsif value.as_i?
        result << value.as_i.to_s.colorize(:white).to_s
      elsif value.as_bool?
        result << value.as_bool.to_s.colorize(:yellow).to_s
      elsif value.as_a?
        result << "[#{value.as_a.size} items]".colorize(:dark_gray).to_s
      elsif value.as_h?
        result << "{#{value.as_h.size} fields}".colorize(:dark_gray).to_s
      end

      count += 1
    end
    result.to_s
  end

  private def process_event(data : JSON::Any)
    type = data["type"]?.try(&.as_s)

    case type
    when "system"
      process_system_event(data)
    when "stream_event"
      process_stream_event(data)
    when "assistant"
      # Full assistant message - already displayed via deltas
    when "tool_result"
      process_tool_result(data)
    when "user"
      process_user_message(data)
    when "result"
      # Final result - can be shown if needed
    end
  end

  private def process_system_event(data : JSON::Any)
    subtype = data["subtype"]?.try(&.as_s)

    case subtype
    when "init"
      model = data["model"]?.try(&.as_s)
      session_id = data["session_id"]?.try(&.as_s)
      @output.puts "🚀 Claude initialized".colorize(:green)
      @output.puts "   🤖 Model: #{model}".colorize(:cyan)
      @output.puts "   🆔 Session: #{session_id}".colorize(:dark_gray)
      @output.puts
    end
  end

  private def process_stream_event(data : JSON::Any)
    event = data["event"]?
    return unless event

    event_type = event["type"]?.try(&.as_s)

    case event_type
    when "message_start"
      @output.print "💭 ".colorize(:blue)
    when "content_block_start"
      process_content_block_start(event)
    when "content_block_delta"
      process_content_block_delta(event)
    when "content_block_stop"
      process_content_block_stop(event)
    when "message_delta"
      # Message metadata updated
    when "message_stop"
      @output.puts if @current_text.empty?
      @output.puts
    end
  end

  private def process_content_block_start(event : JSON::Any)
    content_block = event["content_block"]?
    return unless content_block

    block_type = content_block["type"]?.try(&.as_s)

    case block_type
    when "tool_use"
      @in_tool_use = true
      @tool_name = content_block["name"]?.try(&.as_s) || "unknown"
      tool_id = content_block["id"]?.try(&.as_s)
      @output.puts if !@current_text.empty?
      @output.puts
      @output.puts "#{indent}🔧 #{@tool_name}".colorize(:yellow)
      @tool_input_buffer = String::Builder.new
    when "text"
      @in_tool_use = false
    end
  end

  private def process_content_block_delta(event : JSON::Any)
    delta = event["delta"]?
    return unless delta

    delta_type = delta["type"]?.try(&.as_s)

    case delta_type
    when "text_delta"
      text = delta["text"]?.try(&.as_s) || ""
      @current_text += text
      @output.print text
      @output.flush
    when "input_json_delta"
      json = delta["partial_json"]?.try(&.as_s) || ""
      @tool_input_buffer << json
    end
  end

  private def process_content_block_stop(event : JSON::Any)
    if @in_tool_use
      # Display formatted tool input
      formatted = format_tool_input(@tool_name, @tool_input_buffer.to_s)
      @output.puts formatted
      @output.puts
      @in_tool_use = false
      @tool_input_buffer = String::Builder.new
    end
  end

  private def process_tool_result(data : JSON::Any)
    tool_use_id = data["tool_use_id"]?.try(&.as_s)
    is_error = data["is_error"]?.try(&.as_bool) || false
    content = data["content"]?

    if is_error
      @output.puts "#{indent}  ❌ Error".colorize(:red)
      if content
        content.as_a.each do |item|
          if item["type"]? == "text"
            text = item["text"]?.try(&.as_s) || ""
            # Show error details with indentation
            text.lines.each do |line|
              @output.puts "#{indent}    #{line}".colorize(:red)
            end
          end
        end
      end
    else
      @output.puts "#{indent}  ✅ Success".colorize(:green)
      if content
        content.as_a.each do |item|
          if item["type"]? == "text"
            text = item["text"]?.try(&.as_s) || ""
            # Smart truncation for output
            lines = text.lines
            if lines.size > 50
              # Show first 30 lines, then summary
              lines[0..29].each do |line|
                truncated = line.size > 2000 ? line[0..2000] + "..." : line
                @output.puts "#{indent}    #{truncated}".colorize(:dark_gray)
              end
              @output.puts "#{indent}    📄 (#{lines.size - 30} more lines)".colorize(:dark_gray)
            elsif text.size > 5000
              # Single long line
              @output.puts "#{indent}    #{text[0..5000]}...".colorize(:dark_gray)
              @output.puts "#{indent}    📏 (#{text.size} chars total)".colorize(:dark_gray)
            else
              # Show all content
              lines.each do |line|
                @output.puts "#{indent}    #{line}".colorize(:dark_gray)
              end
            end
          end
        end
      end
    end
    @output.puts
  end

  private def process_user_message(data : JSON::Any)
    content = data["content"]?
    return unless content

    @output.puts
    @output.puts "👤 User:".colorize(:blue)
    if content.as_s?
      @output.puts "   #{content.as_s}".colorize(:white)
    elsif content.as_a?
      content.as_a.each do |item|
        if item["type"]? == "text"
          @output.puts "   #{item["text"]?}".colorize(:white)
        end
      end
    end
    @output.puts
  end
end

# Run the renderer
renderer = ClaudeStreamRenderer.new
renderer.run
