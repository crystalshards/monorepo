class Jobs::NewPage < MainLayout
  needs operation : SaveJob

  def page_title
    "Post a Job"
  end

  def content
    section class: "page-header" do
      h1 do
        text "Post a Job on CrystalGigs"
      end
      para do
        text "Reach thousands of talented Crystal developers"
      end
    end

    section class: "form-section" do
      div class: "form-container" do
        div class: "pricing-info" do
          h3 do
            text "Job Posting - $99"
          end
          ul do
            li do
              text "30 days of visibility"
            end
            li do
              text "Promoted to Crystal developers"
            end
            li do
              text "Featured in email newsletter"
            end
            li do
              text "Share across Crystal ecosystem"
            end
          end
        end

        form_for Jobs::Create, class: "job-form" do
          fieldset do
            legend do
              text "Company Information"
            end

            div class: "form-group" do
              label_for @operation.company_name, "Company Name *"
              text_input @operation.company_name,
                placeholder: "e.g. Acme Corp",
                attrs: [:required]
              # Error display handled by Lucky automatically
            end

            div class: "form-group" do
              label_for @operation.company_url, "Company Website"
              url_input @operation.company_url,
                placeholder: "https://example.com"
              # Error display handled by Lucky automatically
            end
          end

          fieldset do
            legend do
              text "Job Details"
            end

            div class: "form-group" do
              label_for @operation.title, "Job Title *"
              text_input @operation.title,
                placeholder: "e.g. Senior Crystal Developer",
                attrs: [:required]
              # Error display handled by Lucky automatically
            end

            div class: "form-group" do
              label_for @operation.description, "Job Description *"
              textarea @operation.description,
                placeholder: "Describe the role, responsibilities, and requirements...\n\nYou can use basic markdown formatting.",
                rows: "15",
                attrs: [:required]
              # Error display handled by Lucky automatically
            end

            div class: "form-row" do
              div class: "form-group" do
                label_for @operation.job_type, "Job Type *"
                select_input @operation.job_type, attrs: [:required] do
                  option "", "Select type...", selected: @operation.job_type.value.nil?
                  option "full-time", "Full Time", selected: @operation.job_type.value == "full-time"
                  option "part-time", "Part Time", selected: @operation.job_type.value == "part-time"
                  option "contract", "Contract", selected: @operation.job_type.value == "contract"
                  option "freelance", "Freelance", selected: @operation.job_type.value == "freelance"
                  option "internship", "Internship", selected: @operation.job_type.value == "internship"
                end
                # Error display handled by Lucky automatically
              end

              div class: "form-group" do
                label_for @operation.location, "Location"
                text_input @operation.location,
                  placeholder: "e.g. San Francisco, CA"
                # Error display handled by Lucky automatically
              end
            end

            div class: "form-group form-checkbox" do
              checkbox @operation.remote, checked: @operation.remote.value || false
              label_for @operation.remote, "This is a remote position"
            end
          end

          fieldset do
            legend do
              text "Compensation"
            end

            div class: "form-row" do
              div class: "form-group" do
                label_for @operation.salary_min, "Minimum Salary"
                number_input @operation.salary_min,
                  placeholder: "e.g. 80000",
                  step: "1000"
                # Error display handled by Lucky automatically
              end

              div class: "form-group" do
                label_for @operation.salary_max, "Maximum Salary"
                number_input @operation.salary_max,
                  placeholder: "e.g. 120000",
                  step: "1000"
                # Error display handled by Lucky automatically
              end

              div class: "form-group" do
                label_for @operation.salary_currency, "Currency"
                select_input @operation.salary_currency do
                  option "USD", "USD", selected: @operation.salary_currency.value == "USD"
                  option "EUR", "EUR", selected: @operation.salary_currency.value == "EUR"
                  option "GBP", "GBP", selected: @operation.salary_currency.value == "GBP"
                  option "CAD", "CAD", selected: @operation.salary_currency.value == "CAD"
                  option "AUD", "AUD", selected: @operation.salary_currency.value == "AUD"
                end
              end
            end
          end

          fieldset do
            legend do
              text "How to Apply"
            end

            div class: "form-group" do
              label_for @operation.apply_url, "Application URL"
              url_input @operation.apply_url,
                placeholder: "https://example.com/apply"
              para class: "field-help" do
                text "Applicants will be directed to this URL to apply"
              end
              # Error display handled by Lucky automatically
            end

            div class: "form-group" do
              label_for @operation.apply_email, "Application Email"
              email_input @operation.apply_email,
                placeholder: "jobs@example.com"
              para class: "field-help" do
                text "Or provide an email where applicants can send their resume"
              end
              # Error display handled by Lucky automatically
            end

            para class: "field-help-important" do
              text "* At least one application method (URL or email) is required"
            end
          end

          fieldset do
            legend do
              text "Tags (Optional)"
            end

            div class: "form-group" do
              label_for @operation.tags, "Skills & Technologies"
              text_input @operation.tags,
                placeholder: "e.g. Crystal, Web Development, PostgreSQL (comma-separated)"
              para class: "field-help" do
                text "Add relevant skills and technologies, separated by commas"
              end
            end
          end

          div class: "form-actions" do
            submit "Preview & Pay - $99", class: "button button-primary button-large"
          end
        end
      end
    end
  end
end
