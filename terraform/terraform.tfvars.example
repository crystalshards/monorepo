# Copy to terraform.tfvars, or supply these as TF_VAR_<name> environment
# variables in CI. Do not commit a filled in terraform.tfvars: a values file
# takes precedence over TF_VAR_ environment variables, so a checked in
# placeholder silently overrides the real secret CI passes.

project_id = "crystalshards-org"
region     = "us-central1"

# Git commit SHA of the images to create Cloud Run resources at. Required, and
# never "latest": CI pushes only SHA tags.
image_tag = "abc1234"

# Outbound email. Every service calls exit(1) at boot in production without its
# key. "unused" is the app's documented value for running with email off.
crystalshards_sendgrid_key = "your-sendgrid-api-key"
crystaldocs_sendgrid_key   = "your-sendgrid-api-key"
crystalgigs_sendgrid_key   = "your-sendgrid-api-key"
crystalbits_sendgrid_key   = "your-sendgrid-api-key"
docs_launcher_sendgrid_key = "unused"

# CrystalGigs payments
crystalgigs_stripe_secret_key      = "your-stripe-secret-key"
crystalgigs_stripe_publishable_key = "your-stripe-publishable-key"
